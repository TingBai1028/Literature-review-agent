# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM ---
# TODO: decide provider and model (Meterless can route to OpenAI, Anthropic, Google, OpenRouter, or any OpenAI-compatible endpoint)
LLM_PROVIDER=openai
LLM_MODEL=TODO-model-name
LLM_API_KEY=your-key-here

# --- Scholarly APIs ---
# OpenAlex needs no key, but adding an email puts you in the faster "polite pool"
OPENALEX_EMAIL=you@example.com
# Optional: raises Semantic Scholar rate limits
SEMANTIC_SCHOLAR_API_KEY=

# --- Zetaris ---
# TODO: confirm connection details from the Data Day workshop recording on HackOS
ZETARIS_URL=TODO
ZETARIS_USER=TODO
ZETARIS_PASSWORD=TODO

# --- Meterless ---
# TODO: confirm how the world model and Markovian engine are accessed (Resources tab / Help Meterless channel)
METERLESS_CONFIG=TODO

# --- Pipeline ---
# Set to true to run the whole pipeline on fake data without any keys
DRY_RUN=false
