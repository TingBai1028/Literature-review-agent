# Copy this file to .env and fill in real values. Never commit .env.
# Running in Docker? Zetaris and Nightshift run on your machine, outside the container:
# use host.docker.internal instead of localhost in the URLs below.

# --- Pipeline ---
# true = run the whole pipeline on data/sample/ with no Zetaris, Nightshift or network access
SAMPLE_MODE=false
# Port for run.py (POST /run)
PORT=8000
# Stop the run between stages after this many seconds and return a partial result
RUN_TIMEOUT_S=600

# --- LLM: Meterless Nightshift (primary AI provider, OpenAI-compatible) ---
# The model (an NVIDIA Nemotron model) is set in litagent/config.py (NIGHTSHIFT_MODEL).
# The NVIDIA API key lives in Nightshift's Providers tab, never here.
METERLESS_BASE_URL=http://localhost:TODO-port/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token

# --- Zetaris (data layer, runs locally in Docker) ---
# Names from https://github.com/zetaris/getting-started/blob/main/.env.example
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
# Create the key in the Zetaris GUI
ZETARIS_API_KEY=your-zetaris-api-key

# --- Scholarly APIs ---
# OpenAlex: free key from openalex.org raises the daily limit 10x (about 100 -> 1,000 searches a day)
OPENALEX_API_KEY=
# Used only when there is no API key
OPENALEX_EMAIL=you@example.com
# Optional: raises Semantic Scholar rate limits
SEMANTIC_SCHOLAR_API_KEY=
